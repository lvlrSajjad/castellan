{
  "name": "@castellanjs/typeorm",
  "version": "0.1.0-alpha.1",
  "description": "TypeORM policy storage and query scoping (accessibleBy) for castellan.",
  "license": "MIT",
  "author": "Sadjad Asadi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvlrSajjad/castellan.git",
    "directory": "packages/typeorm"
  },
  "homepage": "https://github.com/lvlrSajjad/castellan#readme",
  "bugs": "https://github.com/lvlrSajjad/castellan/issues",
  "keywords": [
    "authorization",
    "abac",
    "rbac",
    "casbin",
    "casl",
    "permissions",
    "typeorm",
    "query-scoping"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@castellanjs/core": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^12.11.1",
    "casbin": "^5.51.1",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.1"
  },
  "peerDependencies": {
    "@castellanjs/core": "workspace:^",
    "casbin": "^5.27.0",
    "typeorm": "^0.3.20 || ^1.0.0"
  }
}
