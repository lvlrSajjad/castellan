{
  "name": "@castellanjs/nestjs",
  "version": "0.1.0-alpha.1",
  "description": "NestJS module, guard and decorators for castellan (CASL-style abilities on Apache Casbin).",
  "license": "MIT",
  "author": "Sadjad Asadi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvlrSajjad/castellan.git",
    "directory": "packages/nestjs"
  },
  "homepage": "https://github.com/lvlrSajjad/castellan#readme",
  "bugs": "https://github.com/lvlrSajjad/castellan/issues",
  "keywords": [
    "authorization",
    "abac",
    "rbac",
    "casbin",
    "casl",
    "permissions",
    "nestjs",
    "guard"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.ts",
          "default": "./dist/index.js"
        },
        "require": {
          "types": "./dist/index.d.cts",
          "default": "./dist/index.cjs"
        }
      },
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@castellanjs/core": "workspace:^",
    "@nestjs/common": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "@nestjs/core": "^10.0.0 || ^11.0.0 || ^12.0.0",
    "reflect-metadata": "^0.2.0",
    "@nestjs/graphql": ">=12.0.0"
  },
  "devDependencies": {
    "@castellanjs/core": "workspace:*",
    "@castellanjs/typeorm": "workspace:*",
    "@nestjs/common": "^12.1.2",
    "@nestjs/core": "^12.1.2",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/testing": "^12.1.2",
    "@nestjs/typeorm": "^12.0.2",
    "@swc/core": "^1.16.13",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "better-sqlite3": "^12.11.1",
    "casbin": "^5.51.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "supertest": "^7.3.1",
    "typeorm": "^1.1.1",
    "unplugin-swc": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/graphql": {
      "optional": true
    }
  }
}
