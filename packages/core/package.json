{
  "name": "@castellan/core",
  "version": "0.0.0",
  "description": "CASL-style abilities compiled to Apache Casbin (incubating) policies: typed RBAC + ABAC with one source of truth.",
  "license": "MIT",
  "author": "Sadjad Asadi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lvlrSajjad/castellan.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/lvlrSajjad/castellan#readme",
  "bugs": "https://github.com/lvlrSajjad/castellan/issues",
  "keywords": [
    "authorization",
    "abac",
    "rbac",
    "casbin",
    "casl",
    "permissions"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "casbin": "^5.27.0"
  },
  "devDependencies": {
    "casbin": "^5.51.1"
  }
}
