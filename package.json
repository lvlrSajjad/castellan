{
  "name": "castellan-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.10.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' build",
    "test": "pnpm -r --filter './packages/*' test",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish",
    "pack:all": "rm -rf dist-packs && mkdir dist-packs && pnpm -r --filter './packages/*' exec pnpm pack --pack-destination ../../dist-packs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "tsup": "^8.5.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
